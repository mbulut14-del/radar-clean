#:kivy 2.1.0
#:import dp kivy.metrics.dp

<MainScreen>:
    FloatLayout:

        Image:
            source: "assets/bg.png"
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1

        ScrollView:
            do_scroll_x: False
            bar_width: dp(6)

            GridLayout:
                cols: 1
                spacing: dp(16)
                padding: dp(14)
                size_hint_y: None
                height: self.minimum_height

                Label:
                    text: "SHORT RADAR"
                    font_size: "24sp"
                    bold: True
                    color: 1, 1, 1, 1
                    size_hint_y: None
                    height: dp(40)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                Label:
                    text: "EN GUCLU SHORT ADAYI"
                    font_size: "20sp"
                    bold: True
                    color: 1, 1, 1, 1
                    size_hint_y: None
                    height: dp(34)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                FloatLayout:
                    size_hint_y: None
                    height: dp(220)

                    Image:
                        source: "assets/hero.png"
                        allow_stretch: True
                        keep_ratio: False
                        size_hint: 1, 1

                    Label:
                        id: hero_score
                        text: "0"
                        font_size: "30sp"
                        bold: True
                        color: 1, 1, 1, 1
                        size_hint: None, None
                        size: dp(76), dp(76)
                        pos_hint: {"x": 0.08, "center_y": 0.50}
                        halign: "center"
                        valign: "middle"
                        text_size: self.size

                    Label:
                        text: "EN GUCLU SHORT"
                        font_size: "14sp"
                        bold: True
                        color: 1, 0.7, 0.2, 1
                        size_hint: None, None
                        size: dp(220), dp(24)
                        pos_hint: {"x": 0.43, "top": 0.76}
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    Label:
                        id: hero_coin
                        text: "Sinyal yok"
                        font_size: "28sp"
                        bold: True
                        color: 1, 1, 1, 1
                        size_hint: None, None
                        size: dp(260), dp(42)
                        pos_hint: {"x": 0.43, "top": 0.60}
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    Label:
                        id: hero_info
                        text: "Su an guclu short adayi bulunamadi."
                        markup: True
                        font_size: "16sp"
                        color: 0.95, 0.95, 0.95, 1
                        size_hint: None, None
                        size: dp(235), dp(96)
                        pos_hint: {"x": 0.43, "y": 0.14}
                        halign: "left"
                        valign: "top"
                        text_size: self.size

                Label:
                    text: "Gate.io Vadeli En Cok Yukselenler"
                    font_size: "18sp"
                    bold: True
                    color: 1, 1, 1, 1
                    size_hint_y: None
                    height: dp(34)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                GridLayout:
                    id: coin_list
                    cols: 1
                    spacing: dp(12)
                    size_hint_y: None
                    height: self.minimum_height
